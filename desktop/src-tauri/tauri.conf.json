{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mesa de Ayuda CECASEM",
  "version": "1.0.0",
  "identifier": "bo.org.cecasem.mesadeayuda",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "devUrl": "http://localhost:47822",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: wss: http://localhost:47821 http://127.0.0.1:47821 http://192.168.88.123:47821 ws://localhost:47821 ws://127.0.0.1:47821 ws://192.168.88.123:47821; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "title": "Mesa de Ayuda CECASEM",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Business",
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null,
      "nsis": null
    }
  }
}
