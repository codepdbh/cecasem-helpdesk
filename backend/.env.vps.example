APP_NAME="Mesa de Ayuda CECASEM"
NODE_ENV=production
SERVER_HOST=127.0.0.1
SERVER_PORT=47821
API_PREFIX=api

# Cambie ayuda.su-dominio.com por el dominio real.
# Recomendado: Nginx publica frontend, /api, /uploads y Socket.IO sobre HTTPS.
FRONTEND_URL=https://ayuda.su-dominio.com
PUBLIC_WEB_URL=https://ayuda.su-dominio.com
ADDITIONAL_CORS_ORIGINS=https://ayuda.su-dominio.com,https://tauri.localhost,tauri://localhost,capacitor://localhost
TRUST_PROXY=true

DATABASE_URL="postgresql://cecasem_ticket_user:CAMBIAR_PASSWORD@127.0.0.1:55433/cecasem_tickets?schema=public"

JWT_SECRET="CAMBIAR_SECRET_LARGO_Y_SEGURO"
JWT_EXPIRES_IN="8h"

UPLOADS_PATH="./uploads"
PROFILE_UPLOADS_PATH="./uploads/profiles"
TICKET_UPLOADS_PATH="./uploads/tickets"
REPORT_UPLOADS_PATH="./uploads/reports"

MAX_FILE_SIZE_MB=10
MAX_PROFILE_PHOTO_SIZE_MB=3
MAX_CONSTANCY_PHOTO_SIZE_MB=5

REQUIRE_USER_APPROVAL=true
