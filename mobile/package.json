{
  "name": "cecasem-helpdesk-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "web:bundle": "powershell -ExecutionPolicy Bypass -File ./scripts/build-web.ps1",
    "icons": "powershell -ExecutionPolicy Bypass -File ./scripts/prepare-icons.ps1",
    "android:add": "npm run web:bundle && cap add android",
    "android:sync": "npm run web:bundle && npm run icons && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "typescript": "~5.7.2"
  }
}
